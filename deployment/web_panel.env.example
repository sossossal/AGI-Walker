# Web panel application env.
# Copy this file to deployment/web_panel.env and set
# AGI_WALKER_COMPOSE_WEB_ENV_FILE=./web_panel.env in deployment/compose.env.

# Authentication.
AGI_WALKER_SECRET_KEY=change-me-before-production

AGI_WALKER_WEB_RUNS_PAGE_SIZE=20
AGI_WALKER_WEB_RUNS_MAX_PAGE_SIZE=100
AGI_WALKER_WEB_ARCHIVE_MAX_RUNS=200
AGI_WALKER_WEB_ARCHIVE_MAX_AGE_DAYS=30

# Optional distributed monitor endpoint used by the Web panel.
AGI_WALKER_ZENOH_ENDPOINT=tcp/zenoh-router:7447

# Container path overrides are controlled by deployment/compose.env:
# AGI_WALKER_DATABASE_URL
# AGI_WALKER_WEB_OUTPUT_ROOT
# AGI_WALKER_WEB_ARCHIVE_ROOT
#
# Host-side runtime directories are controlled by deployment/compose.env:
# <runtime-root>/db
# <runtime-root>/workflow_runs
# <runtime-root>/workflow_archive
# <runtime-root>/backups
