# Host-side Docker Compose overrides.
# Copy this file to deployment/compose.env and pass it with:
# docker compose --env-file deployment/compose.env -f deployment/docker-compose.yml ...

# Compose-level env file used to inject application variables into the containers.
AGI_WALKER_COMPOSE_WEB_ENV_FILE=./web_panel.env

# Host bind-mount root for persistent runtime data.
AGI_WALKER_RUNTIME_ROOT=./runtime

# Host ports.
AGI_WALKER_WEB_PORT=8080
AGI_WALKER_WEB_DISTRIBUTED_PORT=8081
AGI_WALKER_ZENOH_TCP_PORT=7447
AGI_WALKER_ZENOH_REST_PORT=18000
AGI_WALKER_ZENOH_BASE_IMAGE=eclipse/zenoh:1.9.0
AGI_WALKER_ZENOH_IMAGE=deployment-zenoh-router

# Container-side persistent paths injected by Docker Compose.
AGI_WALKER_DATABASE_URL=sqlite+aiosqlite:////var/lib/agi_walker/db/agi_walker.db
AGI_WALKER_WEB_OUTPUT_ROOT=/var/lib/agi_walker/workflow_runs
AGI_WALKER_WEB_ARCHIVE_ROOT=/var/lib/agi_walker/workflow_archive
