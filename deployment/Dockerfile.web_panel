ARG WEB_PANEL_BASE_IMAGE=python:3.11-alpine
FROM ${WEB_PANEL_BASE_IMAGE}

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY deployment/requirements.web_panel.txt /app/deployment/requirements.web_panel.txt
COPY deployment/requirements.web_panel.distributed.txt /app/deployment/requirements.web_panel.distributed.txt

ARG WEB_PANEL_APT_PACKAGES=""
ARG WEB_PANEL_APK_PACKAGES="libgcc"
ARG WEB_PANEL_APK_BUILD_PACKAGES="build-base"
ARG WEB_PANEL_REQUIREMENTS_FILE=/app/deployment/requirements.web_panel.txt

RUN if command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        apt-get dist-upgrade -y && \
        if [ -n "$WEB_PANEL_APT_PACKAGES" ]; then \
            apt-get install -y --no-install-recommends $WEB_PANEL_APT_PACKAGES; \
        fi && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
        apk upgrade --no-cache && \
        if [ -n "$WEB_PANEL_APK_PACKAGES" ]; then \
            apk add --no-cache $WEB_PANEL_APK_PACKAGES; \
        fi && \
        if [ -n "$WEB_PANEL_APK_BUILD_PACKAGES" ]; then \
            apk add --no-cache --virtual .web-panel-build-deps $WEB_PANEL_APK_BUILD_PACKAGES; \
        fi; \
    else \
        echo "unsupported base image package manager" >&2; \
        exit 1; \
    fi && \
    rm -rf /tmp/*

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r "$WEB_PANEL_REQUIREMENTS_FILE" && \
    if command -v apk >/dev/null 2>&1 && apk info -e .web-panel-build-deps >/dev/null 2>&1; then \
        apk del .web-panel-build-deps; \
    fi && \
    rm -rf /root/.cache /tmp/*

COPY . /app

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "web_panel.server:app", "--host", "0.0.0.0", "--port", "8000"]
