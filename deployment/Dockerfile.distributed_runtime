FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY deployment/requirements.distributed_runtime.txt /app/deployment/requirements.distributed_runtime.txt

RUN python -m pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r /app/deployment/requirements.distributed_runtime.txt

COPY . /app

# Keep the distributed runtime image aligned with the package's declared
# baseline dependencies so importing agi_walker matches local execution.
RUN pip install --no-cache-dir . && \
    python -c "import yaml; from agi_walker.skills_loader import SkillsLoader; print('distributed_runtime_import_ok')"

CMD ["python", "-u", "-m", "agi_walker.core.distributed.run_learner"]
